<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="WebAppPromocionCauca.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%: Page.Title %></title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
    /* PALETA DE COLORES DEL CAUCA */
    :root {
        --blanco-encalado: #F5F5F5;
        --verde-paramo: #2D5A27;
        --terracota: #A0522D;
        --texto-oscuro: #222222;
    }

    body {
        background-color: var(--blanco-encalado) !important;
        color: var(--texto-oscuro);
            margin:0;
    padding:0;
    width:100%;
    overflow-x:hidden;
    }
    .body-content{
        width:100%;
        min-height:60vh;
        margin:0 !important;
        padding-top:45px;
    }
    .navbar{
        min-height:70px;
        padding:0.8rem 0;
        background:rgba(20,40,30,.95)!important;
        backdrop-filter:blur(8px);
        z-index:9999;
    }

    html {
    scroll-behavior: smooth;
    }

    /* Personalización de botones con la identidad visual */
    .btn-cauca-principal {
        background-color: var(--verde-paramo) !important;
        color: #FFFFFF !important;
        border: none !important;
        transition: background-color 0.3s;
    }

    .btn-cauca-principal:hover {
        background-color: var(--terracota) !important;
    }

    .text-cauca-terracota {
        color: var(--terracota) !important;
    }
</style>
    <asp:ContentPlaceHolder ID="Stylesheets" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form runat="server">
<asp:ScriptManager runat="server" EnablePageMethods="true">
    <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>

    <nav class="navbar navbar-expand-sm navbar-dark fixed-top">
            <div class="container">
                <a class="navbar-brand" runat="server" href="~/">Cauca Turístico</a>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" href="/Default.aspx">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Default.aspx#subregiones">Subregiones</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Rutas.aspx">Rutas</a></li>
                    </ul>

                </div>
            </div>
        </nav>
        <!-- CONTENEDOR PRINCIPAL DE CONTENIDO -->
    <div class="body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <!-- 🏔️ PIE DE PÁGINA EXPANDIDO CON LA IDENTIDAD DEL CAUCA -->
<footer style="background-color: var(--verde-paramo); color: #FFFFFF; padding: 3rem 0; margin-top: 4rem;">
    <div class="container">
        <div class="row g-4 text-center text-md-start">
            <!-- Columna 1: Branding -->
            <div class="col-md-6">
                <h5 class="fw-bold text-uppercase" style="letter-spacing: 1px;">Vive Cauca</h5>
                <p class="small text-white-50 mt-2" style="max-width: 400px;">
                    Portal oficial de promoción turística. Descubre la Ciudad Blanca, la majestuosidad del Macizo Colombiano y los saberes ancestrales de nuestro territorio.
                </p>
            </div>
            <!-- Columna 2: Enlaces Rápidos -->
            <div class="col-md-3">
                <h6 class="fw-bold text-uppercase text-white-50">Explorar</h6>
                <ul class="list-unstyled mt-2 lh-lg">
                    <li><a href="/Default.aspx" class="text-white text-decoration-none small opacity-75">Inicio</a></li>
                    <li><a href="/Rutas.aspx" class="text-white text-decoration-none small opacity-75">Rutas Oficiales</a></li>
                    <li><a href="/Default.aspx#subregiones" class="text-white text-decoration-none small opacity-75">Subregiones</a></li>
                    <li><a href="/Default.aspx#reconocimientos" class="text-white text-decoration-none small opacity-75">Reconocimientos</a></li>
                </ul>
            </div>

            <!-- Columna 3: Información Legal o Soporte -->
            <div class="col-md-3">
                <h6 class="fw-bold text-uppercase text-white-50">Conéctate</h6>
                <p class="small mb-2">
                    <a href="https://cauca.gov.co/" target="_blank" rel="noopener noreferrer" class="text-white text-decoration-none opacity-75 d-block" title="Sitio web oficial de la Gobernación del Cauca">
                        <i class="bi bi-globe me-2"></i>Gobernación del Cauca
                    </a>
                </p>
                <p class="small text-white-50 mb-1">
                    <i class="bi bi-geo-alt me-2"></i>Popayán, Cauca - Colombia
                </p>
                <p class="small mb-1">
                    <a href="tel:018000919748" class="text-white text-decoration-none opacity-75 d-block" title="Llamar a la Línea de Atención al Ciudadano">
                        <i class="bi bi-telephone me-2"></i>01 8000 919748
                    </a>
                </p>
                <p class="small mb-3">
                    <a href="mailto:contactenos@cauca.gov.co" class="text-white text-decoration-none opacity-75 d-block" title="Enviar correo electrónico institucional">
                        <i class="bi bi-envelope me-2"></i>contactenos@cauca.gov.co
                    </a>
                </p>

                <!-- Redes Sociales Oficiales -->
                <div class="d-flex justify-content-center justify-content-md-start gap-3 text-white-50 fs-5">
                    <a href="https://www.facebook.com/share/1cRDX19A6C/?mibextid=wwXIfr" target="_blank" rel="noopener noreferrer" class="text-white opacity-75" title="Facebook Gobernación del Cauca">
                        <i class="bi bi-facebook"></i>
                    </a>
                    <a href="https://www.instagram.com/secdesarrollocauca?igsh=MXZ0eThvNXZvbXYzcQ==" target="_blank" rel="noopener noreferrer" class="text-white opacity-75" title="Instagram Gobernación del Cauca">
                        <i class="bi bi-instagram"></i>
                    </a>
                    <a href="https://x.com/SDEC_CAUCA" target="_blank" rel="noopener noreferrer" class="text-white opacity-75" title="X (Twitter) Gobernación del Cauca">
                        <i class="bi bi-twitter-x"></i>
                    </a>
                </div>
            </div>

        </div>
        <!-- Derechos de Autor -->
        <hr class="mt-4 border-secondary opacity-25">
        <div class="row">
            <div class="col text-center text-white-50">
                <p class="small mb-0">&copy; 2026 Vive Cauca. Todos los derechos reservados.</p>
            </div>
        </div>
    </div>
</footer>


    </form>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>

<script>
AOS.init({
    duration: 1200,
    once: true,
    offset: 100
});
</script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
</body>
</html>
